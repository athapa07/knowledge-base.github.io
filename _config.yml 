title: Knowledge Base
description: A personal knowledge base of tools, guides, and notes.
theme: just-the-docs

url: "https://athapa07.github.io"
baseurl: "/knowledge-base.github.io"

# Enable search
search_enabled: true
search:
  heading_level: 2
  previews: 3
  preview_words_before: 5
  preview_words_after: 10
  tokenizer_separator: /[\s/]+/
  rel_url: true
  button: false

# Aux links shown in the top nav bar
aux_links:
  "View on GitHub":
    - "https://github.com/athapa07/knowledge-base.github.io"

nav_sort: case_insensitive

plugins:
  - jekyll-seo-tag
  - jekyll-sitemap

exclude:
  - Gemfile
  - Gemfile.lock
  - node_modules
  - vendor